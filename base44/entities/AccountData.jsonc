{
  "name": "AccountData",
  "type": "object",
  "properties": {
    "account_email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "data": {
      "type": "string",
      "title": "\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 (JSON)"
    },
    "data_version": {
      "type": "number",
      "title": "\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a",
      "default": 1
    }
  },
  "required": [
    "account_email",
    "data"
  ],
  "rls": {
    "create": {
      "data.account_email": "{{user.email}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}