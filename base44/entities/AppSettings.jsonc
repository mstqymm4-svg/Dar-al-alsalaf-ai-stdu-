{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "title": "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f"
    },
    "setting_value": {
      "type": "string",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0625\u0639\u062f\u0627\u062f"
    },
    "setting_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0639\u062f\u0627\u062f",
      "enum": [
        "color",
        "font",
        "text",
        "boolean",
        "url",
        "json"
      ],
      "default": "text"
    },
    "changed_by": {
      "type": "string",
      "title": "\u062a\u0645 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
