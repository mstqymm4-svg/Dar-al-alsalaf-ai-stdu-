{
  "name": "VideoChannel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0646\u0627\u0629"
    },
    "channel_logo": {
      "type": "string",
      "title": "\u0634\u0639\u0627\u0631 \u0627\u0644\u0642\u0646\u0627\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0642\u0646\u0627\u0629"
    },
    "youtube_url": {
      "type": "string",
      "title": "\u0631\u0627\u0628\u0637 \u0642\u0646\u0627\u0629 \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628"
    },
    "category": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641",
      "default": "\u0639\u0627\u0645"
    },
    "sort_order": {
      "type": "number",
      "title": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0638\u0647\u0648\u0631",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "title": "\u0638\u0627\u0647\u0631\u0629",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
